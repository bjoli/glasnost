(package
  (name (glasnost))
  (version "0.3.7")
  (description "A site that is made as it is read: samizdat pages, generated when asked for and kept until their sources change; folders as menus, as Gopher had them.")
  (license "MPL-2.0")

  (depends
    ;; 0.5.1 says in one line that the port is taken; 0.6.0 sends a file from
    ;; the disk, which a kept page and an asset are answered with. 0.6.2,
    ;; 0.7.2 and 0.1.3 below: Bjolang's strings are UTF-8. 0.7.0: Bjolang's
    ;; one input port type.
    (package (name (bjoweb))
             (version (version-at-least "0.8.0"))
             (source (git (url "https://github.com/bjoli/bjoweb"))))
    ;; 0.3.0 says what files a document was made from.
    ;; 0.5.0: a code block is coloured when the HTML converter is given a
    ;; highlighter.
    ;; 0.6.0: @defmodule, @defdoc, @defdocs and @docref show a Bjolang
    ;; module's own docs, read from its dll. 0.7.0: @generate-docs makes a
    ;; whole page of them. 0.8.1 closes every bracket it opens, which the
    ;; Bjolang reader requires.
    (package (name (samizdat))
             (version (version-at-least "0.8.1"))
             (source (git (url "https://github.com/bjoli/samizdat"))))
    ;; The highlighter, and the style sheet for its classes. samizdat brings
    ;; it too; it is named here because the layout uses it itself. 0.1.1
    ;; declares its grammars as a resource, which bjo publish needs to copy
    ;; them into the container.
    (package (name (textmate-bjolang))
             (version (version-at-least "0.1.3"))
             (source (git (url "https://rikspucko.koketteriet.se/bjoli/textmate-bjolang")))))

  ;; A program: src/main.bjo.
  )
