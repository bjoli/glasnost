(package
  (name (glasnost))
  (version "0.3.0")
  (description "A site that is made as it is read: samizdat pages, generated when asked for and kept until their sources change; folders as menus, as Gopher had them.")
  (license "MPL-2.0")

  (depends
    ;; 0.5.1 says in one line that the port is taken; 0.6.0 sends a file from
    ;; the disk, which a kept page and an asset are answered with.
    (package (name (bjoweb))
             (version (version-at-least "0.6.0"))
             (source (git (url "https://github.com/bjoli/bjoweb"))))
    ;; 0.3.0 says what files a document was made from.
    ;; 0.5.0: a code block is coloured when the HTML converter is given a
    ;; highlighter.
    (package (name (samizdat))
             (version (version-at-least "0.5.0"))
             (source (git (url "https://github.com/bjoli/samizdat"))))
    ;; The highlighter, and the style sheet for its classes. samizdat brings
    ;; it too; it is named here because the layout uses it itself.
    (package (name (textmate-bjolang))
             (version (version-at-least "0.1.0"))
             (source (git (url "https://rikspucko.koketteriet.se/bjoli/textmate-bjolang")))))

  ;; A program: src/main.bjo.
  )
