(package
  (name (glasnost))
  (version "0.4.0")
  (description "A site that is made as it is read: samizdat pages, generated when asked for and kept until their sources change; folders as menus, as Gopher had them.")
  (license "MPL-2.0")

  (depends
    ;; 0.5.1 says in one line that the port is taken; 0.6.0 sends a file from
    ;; the disk, which a kept page and an asset are answered with. 0.6.2,
    ;; 0.7.2 and 0.1.3 below: Bjolang's strings are UTF-8. 0.7.0: Bjolang's
    ;; one input port type. 0.9.0: its one output port type. 0.10.0
    ;; allocates a third less for each request. 0.10.1 names the types its
    ;; only lists use, which Bjolang 0.1.0 requires. 0.12.0 uses
    ;; string-find, char->int and vec-contains?, as Bjolang names them.
    (package (name (bjoweb))
             (version (version-at-least "0.12.1"))
             (source (git (url "https://github.com/bjoli/bjoweb"))))
    ;; The highlighter, and the style sheet for its classes. samizdat, which is
    ;; in Bjolang's distribution, takes it as a function. 0.1.1
    ;; declares its grammars as a resource, which bjo publish needs to copy
    ;; them into the container. 0.2.0 declares grammars, which Bjolang 0.2.0
    ;; requires. 0.2.1 names the type its only list uses. 0.2.3 uses
    ;; vec-append and vec-contains?, as Bjolang names them.
    (package (name (textmate-bjolang))
             (version (version-at-least "0.2.4"))
             (source (git (url "https://rikspucko.koketteriet.se/bjoli/textmate-bjolang")))))

  ;; A program: src/main.bjo.
  )
