# glasnost, serving the site mounted at /site.
#
#   container/build.sh
#   podman run -d --name site -p 8080:8080 \
#       -v /path/to/site:/site:ro,Z -v glasnost-cache:/cache glasnost
#
# Pages are kept in /cache, so the site can be mounted read-only. Inside, it
# listens on 8080; `podman run ... glasnost --port N` changes that.
#
# The base is Microsoft's chiseled ASP.NET image: no shell and no package
# manager, about half the size of the regular one, and running as the app user
# (uid 1654). It has no ICU, so .NET runs with invariant globalization; the
# pages it serves are the same as with the regular image.
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled

# What `bjo publish` made: the program and everything it loads.
COPY app/ /app/

# The directories the program needs, made by build.sh, since there is no shell
# here to make them. /cache is written to, so it belongs to the app user the
# image runs as. ASP.NET's content root is the working directory, and it makes
# a wwwroot there if there is none, which a read-only one would refuse.
COPY --chown=1654:1654 skel/ /

WORKDIR /srv/glasnost
EXPOSE 8080
VOLUME ["/cache"]

ENTRYPOINT ["/usr/bin/dotnet", "/app/main.exe", "/site", "--cache", "/cache", "--host", "0.0.0.0"]
CMD ["--port", "8080"]
