;; glasnost/src/fingerprint.bjo — the module (glasnost fingerprint).
;;
;; What a cached page depends on besides its sources is the code that made it:
;; the commands, the layout, samizdat, Markdig, the highlighter. The cache is
;; kept under a name made from that code, so that a change to any of it starts
;; a fresh cache rather than serving pages the old code made.
;;
;; The fingerprint is a hash of the module version id of every assembly the
;; program can run, found by following references from the program's own
;; assembly — without running any of it — and leaving out .NET's shared
;; frameworks, which the version of .NET stands for. A compiler gives an
;; assembly a new module version id when it is compiled again, so a rebuild
;; with a change is a new fingerprint; one without a change may be too, which
;; costs a page being made again and never serves an old one.

(export fingerprint)

(import (std prelude))

(import/class
  (Object (: System.Object))
  (Assembly (: System.Reflection.Assembly))
  (AssemblyName (: System.Reflection.AssemblyName))
  (Module (: System.Reflection.Module))
  (Guid (: System.Guid)))

(import/extern
  (entry-assembly (: System.Reflection.Assembly.GetEntryAssembly (-> Assembly)))
  (references (: System.Reflection.Assembly.GetReferencedAssemblies (-> Assembly (Array AssemblyName))))
  (load-assembly (: System.Reflection.Assembly.Load (-> AssemblyName Assembly)))
  (assembly-name (: System.Reflection.Assembly.FullName (-> Assembly string) #:get))
  (reference-name (: System.Reflection.AssemblyName.FullName (-> AssemblyName string) #:get))
  (assembly-location (: System.Reflection.Assembly.Location (-> Assembly string) #:get))
  (manifest-module (: System.Reflection.Assembly.ManifestModule (-> Assembly Module) #:get))
  (module-version (: System.Reflection.Module.ModuleVersionId (-> Module Guid) #:get))
  (runtime-directory (: System.Runtime.InteropServices.RuntimeEnvironment.GetRuntimeDirectory (-> string)))
  (parent-directory (: System.IO.Path.GetDirectoryName (-> string string)))
  (sha256 (: System.Security.Cryptography.SHA256.HashData (-> (Array byte) (Array byte))))
  (hex (: System.Convert.ToHexString (-> (Array byte) string))))

;; .NET's shared frameworks — Microsoft.NETCore.App, Microsoft.AspNetCore.App —
;; are the directories beside the runtime's own: .../shared/<framework>/<version>/.
(: shared-frameworks (-> string))
(defun (shared-frameworks)
  (def runtime (runtime-directory))
  ;; Its trailing separator first, or the first parent is the runtime again.
  (def bare (if (or (string-ends-with? runtime "/") (string-ends-with? runtime "\\"))
                (.Substring runtime 0 (- (string-length runtime) 1))
                runtime))
  (parent-directory (parent-directory bare)))

;; Every assembly reachable from `start`, by full name, the frameworks' left
;; out and not followed.
(: reachable (-> Assembly string (Map string Assembly)))
(defun (reachable start shared)
  (let go ((pending (vec-add (vec-empty) start)) (seen (map-empty)))
    (if (vec-empty? pending)
        seen
        (let* ((a (vec-ref pending (- (vec-length pending) 1)))
               (rest (vec-remove-at pending (- (vec-length pending) 1)))
               (name (assembly-name a)))
          (if (or (map-contains? seen name)
                  (string-empty? (assembly-location a))
                  (string-starts-with? (assembly-location a) shared))
              (go rest seen)
              (go (loop (:for r (references a))
                        (:when (not (map-contains? seen (reference-name r))))
                        (:acc more (folding rest
                                            (match (try (load-assembly r) #:catch (System.Exception))
                                              ((Ok loaded) (vec-add more loaded))
                                              ((Err e) more)))))
                  (map-set seen name a)))))))

;; Twelve hex digits of the hash of the program's code.
(: fingerprint (-> string))
(defun (fingerprint)
  (def found (reachable (entry-assembly) (shared-frameworks)))
  (def names (list-sort (loop (:for name (map-keys found)) (:acc (listing name)))))
  (def lines (loop (:for name names)
                   (:acc (vecing (str name " " (.ToString (module-version (manifest-module (map-ref found name)))))))))
  (string-downcase (.Substring (hex (sha256 (string->bytes (string-join lines "\n")))) 0 12)))
